generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  password       String
  photo          String?
  roomAssignment String?
  moveInDate     DateTime?
  dietaryFlags   String    @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships              ApartmentMember[]
  houseRuleAcknowledgments HouseRuleAcknowledgment[]
  assignedChores           Chore[]            @relation("ChoreAssignee")
  completedChores          Chore[]            @relation("ChoreCompleter")
  chorePhotos              ChorePhoto[]       @relation("PhotoTaker")
  swapRequestsFrom         ChoreSwapRequest[] @relation("SwapFrom")
  swapRequestsTo           ChoreSwapRequest[] @relation("SwapTo")
  expensesPaid             Expense[]          @relation("ExpensePayer")
  expenseSplits            ExpenseSplit[]
  settlementsFrom          Settlement[]       @relation("SettlementFrom")
  settlementsTo            Settlement[]       @relation("SettlementTo")
  rentCyclesAsPayer        RentCycle[]
  rentPayments             RentPayment[]
  notifications            Notification[]
  groceryItemsAdded        GroceryItem[]
  fundContributions        FundTransaction[]
  feedItems                FeedItem[]
  feedReactions            FeedReaction[]
  ruleVotes                RuleVote[]
  calendarEvents           CalendarEvent[]
  chatMessagesSent         ChatMessage[]   @relation("ChatSender")
  directMessagesSent       DirectMessage[] @relation("DMSender")
  directMessagesReceived   DirectMessage[] @relation("DMReceiver")
  callsInitiated           CallSession[]   @relation("CallCaller")
  borrowRequests           BorrowRequest[]
  roommateScore            RoommateScore[]
  disputesRaised           Dispute[]       @relation("DisputeRaiser")
  disputesAgainst          Dispute[]       @relation("DisputeAgainst")
  disputeComments          DisputeComment[]
}

model Apartment {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members    ApartmentMember[]
  houseRules HouseRule[]
  rooms      Room[]
  chores     Chore[]
  expenses   Expense[]
  settlements Settlement[]
  rentConfig RentConfig?
  rentCycles RentCycle[]
  notifications Notification[]
  groceryItems  GroceryItem[]
  inventoryItems InventoryItem[]
  fund          ApartmentFund?
  fundTransactions FundTransaction[]
  feedItems     FeedItem[]
  calendarEvents CalendarEvent[]
  sharedAgreements SharedAgreement[]
  chatMessages   ChatMessage[]
  directMessages DirectMessage[]
  callSessions   CallSession[]
  borrowRequests BorrowRequest[]
  purchaseRotations PurchaseRotation[]
  roommateScores RoommateScore[]
  disputes       Dispute[]
}

model Room {
  id                String   @id @default(cuid())
  name              String
  type              String   @default("CUSTOM")
  cleanlinessStatus String   @default("CLEAN")
  maintenanceFlag   Boolean  @default(false)
  maintenanceNotes  String?
  createdAt         DateTime @default(now())

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  chores      Chore[]
  photos      ChorePhoto[]
}

model Chore {
  id             String    @id @default(cuid())
  title          String
  assignmentType String    @default("ROTATING")
  frequency      String    @default("WEEKLY")
  dueDate        DateTime?
  status         String    @default("PENDING")
  completedAt    DateTime?
  points         Int       @default(2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  apartmentId    String
  roomId         String?
  assignedUserId String?
  completedById  String?

  apartment   Apartment  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  room        Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assignedTo  User?      @relation("ChoreAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  completedBy User?      @relation("ChoreCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  photos      ChorePhoto[]
  swapRequests ChoreSwapRequest[]
}

model ChorePhoto {
  id        String   @id @default(cuid())
  url       String
  takenAt   DateTime @default(now())

  choreId   String?
  roomId    String?
  takenById String

  chore   Chore?  @relation(fields: [choreId], references: [id], onDelete: Cascade)
  room    Room?   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  takenBy User    @relation("PhotoTaker", fields: [takenById], references: [id], onDelete: Cascade)
}

model ChoreSwapRequest {
  id        String   @id @default(cuid())
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  choreId        String
  fromUserId     String
  toUserId       String

  chore    Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SwapFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User  @relation("SwapTo", fields: [toUserId], references: [id], onDelete: Cascade)
}

model ApartmentMember {
  id         String    @id @default(cuid())
  role       String    @default("MEMBER")
  status     String    @default("ACTIVE")
  joinedAt   DateTime  @default(now())
  movedOutAt DateTime?

  userId      String
  apartmentId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([userId, apartmentId])
}

model HouseRule {
  id         String    @id @default(cuid())
  content    String
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  proposedAt  DateTime  @default(now())
  votingEndsAt DateTime?
  status      String    @default("ACTIVE") // PROPOSED | ACTIVE | ARCHIVED

  apartmentId     String
  apartment       Apartment               @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  acknowledgments HouseRuleAcknowledgment[]
  votes           RuleVote[]
}

model HouseRuleAcknowledgment {
  id             String   @id @default(cuid())
  acknowledgedAt DateTime @default(now())

  userId      String
  houseRuleId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseRule   HouseRule @relation(fields: [houseRuleId], references: [id], onDelete: Cascade)

  @@unique([userId, houseRuleId])
}

// ── Finance ──────────────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String   @default("GENERAL")
  splitMethod String   @default("EQUAL")  // EQUAL | CUSTOM | PER_PERSON
  isRecurring Boolean  @default(false)
  frequency   String?                     // WEEKLY | MONTHLY
  status      String   @default("ACTIVE") // ACTIVE | SETTLED | DISPUTED
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  apartmentId String
  paidById    String
  apartment   Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  paidBy      User         @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Cascade)
  splits      ExpenseSplit[]
}

model ExpenseSplit {
  id         String    @id @default(cuid())
  amount     Float
  status     String    @default("PENDING") // PENDING | PAID
  settledAt  DateTime?

  expenseId String
  userId    String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model Settlement {
  id          String   @id @default(cuid())
  amount      Float
  method      String   @default("CASH") // VENMO | PAYPAL | CASHAPP | CASH | BANK
  confirmedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  apartmentId String
  fromUserId  String
  toUserId    String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  fromUser    User      @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User      @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)
}

// ── Rent ─────────────────────────────────────────────────────────────────────

model RentConfig {
  id            String   @id @default(cuid())
  totalAmount   Float
  dueDay        Int      @default(1)   // day of month rent is due
  landlordName  String?
  autoRotate    Boolean  @default(false)
  shares        String   @default("{}") // JSON: { userId: amount }
  updatedAt     DateTime @updatedAt

  apartmentId String    @unique
  rentPayerId String?
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

model RentCycle {
  id           String    @id @default(cuid())
  month        String    // YYYY-MM
  totalAmount  Float
  markedPaidAt DateTime?
  createdAt    DateTime  @default(now())

  apartmentId String
  rentPayerId String
  apartment   Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  rentPayer   User        @relation(fields: [rentPayerId], references: [id], onDelete: Cascade)
  payments    RentPayment[]

  @@unique([apartmentId, month])
}

model RentPayment {
  id          String    @id @default(cuid())
  amount      Float
  status      String    @default("PENDING") // PENDING | PAID | CONFIRMED
  method      String?                        // VENMO | PAYPAL | CASHAPP | CASH | BANK
  paidAt      DateTime?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  rentCycleId String
  userId      String
  rentCycle   RentCycle @relation(fields: [rentCycleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rentCycleId, userId])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  type      String   // CHORE_DUE | CHORE_OVERDUE | RENT_REMINDER | EXPENSE_ADDED | MEMBER_JOINED | RULE_ADDED | NUDGE | FUND_LOW
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  userId      String
  apartmentId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

// ── Inventory & Grocery ───────────────────────────────────────────────────────

model GroceryItem {
  id          String   @id @default(cuid())
  name        String
  quantity    String   @default("1")
  addedById   String
  purchased   Boolean  @default(false)
  purchasedAt DateTime?
  createdAt   DateTime @default(now())

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  addedBy     User      @relation(fields: [addedById], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id               String    @id @default(cuid())
  name             String
  category         String    @default("SUPPLIES") // SUPPLIES | FOOD | APPLIANCE | OTHER
  quantity         Float     @default(1)
  unit             String    @default("units")
  reorderThreshold Float     @default(1)
  expiryDate       DateTime?
  isShared         Boolean   @default(true)
  condition        String    @default("GOOD") // GOOD | FAIR | POOR
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apartmentId String
  apartment   Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  borrows     BorrowRequest[]
}

// ── Apartment Fund ────────────────────────────────────────────────────────────

model ApartmentFund {
  id        String   @id @default(cuid())
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt

  apartmentId  String    @unique
  apartment    Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  transactions FundTransaction[]
}

model FundTransaction {
  id          String   @id @default(cuid())
  type        String   // CONTRIBUTION | WITHDRAWAL
  amount      Float
  description String
  createdAt   DateTime @default(now())

  fundId      String
  apartmentId String
  userId      String
  fund        ApartmentFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  apartment   Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Activity Feed ─────────────────────────────────────────────────────────────

model FeedItem {
  id          String   @id @default(cuid())
  type        String   // EXPENSE | CHORE_DONE | MEMBER_JOINED | RULE_ADDED | ANNOUNCEMENT | RENT | GROCERY | FUND
  title       String
  body        String
  isAnnouncement Boolean @default(false)
  link        String?
  createdAt   DateTime @default(now())

  apartmentId String
  userId      String
  apartment   Apartment  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions   FeedReaction[]
}

model FeedReaction {
  id        String   @id @default(cuid())
  emoji     String   // THUMBS_UP | NOTED | QUESTION
  createdAt DateTime @default(now())

  feedItemId String
  userId     String
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedItemId, userId])
}

// ── House Rules Voting ────────────────────────────────────────────────────────

model RuleVote {
  id        String   @id @default(cuid())
  vote      String   // YES | NO
  createdAt DateTime @default(now())

  houseRuleId String
  userId      String
  houseRule   HouseRule @relation(fields: [houseRuleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([houseRuleId, userId])
}

// ── Calendar ──────────────────────────────────────────────────────────────────

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("EVENT") // EVENT | MAINTENANCE | GUEST | RENT | TRAVEL
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())

  apartmentId String
  userId      String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Shared Agreements ─────────────────────────────────────────────────────────

model SharedAgreement {
  id          String   @id @default(cuid())
  key         String   // LEASE_START | LEASE_END | RENT_DUE_DAY | WIFI_NAME | WIFI_PASSWORD | EMERGENCY_CONTACT | CUSTOM
  label       String
  value       String
  updatedAt   DateTime @updatedAt

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([apartmentId, key])
}

// ── Chat ──────────────────────────────────────────────────────────────────────

model ChatMessage {
  id        String    @id @default(cuid())
  content   String
  type      String    @default("TEXT") // TEXT | IMAGE | SYSTEM | EMERGENCY
  readBy    String    @default("[]")   // JSON: userId[]
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  apartmentId String
  senderId    String
  replyToId   String?

  apartment Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  sender    User         @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo   ChatMessage? @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReply")
}

model DirectMessage {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("TEXT") // TEXT | IMAGE
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  apartmentId String
  senderId    String
  receiverId  String

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  sender    User      @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User      @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

// ── Call Signaling ────────────────────────────────────────────────────────────

model CallSession {
  id            String    @id @default(cuid())
  type          String    // VOICE | VIDEO
  status        String    @default("RINGING") // RINGING | ACTIVE | ENDED | DECLINED
  offer         String?
  answer        String?
  callerIce     String    @default("[]") // JSON: RTCIceCandidate[]
  receiverIce   String    @default("[]")
  isEmergency   Boolean   @default(false)
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  apartmentId String
  callerId    String
  receiverId  String?   // null = group call

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  caller    User      @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
}

// ── Phase 7: Inventory Polish ─────────────────────────────────────────────────

model BorrowRequest {
  id          String    @id @default(cuid())
  status      String    @default("ACTIVE")  // ACTIVE | RETURNED
  notes       String?
  borrowedAt  DateTime  @default(now())
  returnedAt  DateTime?

  inventoryItemId String
  borrowerId      String
  apartmentId     String

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  borrower      User          @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  apartment     Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

model PurchaseRotation {
  id           String   @id @default(cuid())
  itemName     String
  frequency    String   @default("MONTHLY") // WEEKLY | BIWEEKLY | MONTHLY
  currentIndex Int      @default(0)
  memberOrder  String   // JSON: userId[]
  lastBought   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

// ── Phase 8: Scores & Disputes ────────────────────────────────────────────────

model RoommateScore {
  id         String   @id @default(cuid())
  score      Int      @default(50)
  visibility String   @default("TIER") // EXACT | TIER | PRIVATE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId      String
  apartmentId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  logs        ScoreLog[]

  @@unique([userId, apartmentId])
}

model ScoreLog {
  id        String   @id @default(cuid())
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  scoreId String
  score   RoommateScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)
}

model Dispute {
  id          String    @id @default(cuid())
  title       String
  description String
  status      String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  apartmentId String
  raisedById  String
  againstId   String?

  apartment Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  raisedBy  User             @relation("DisputeRaiser", fields: [raisedById], references: [id], onDelete: Cascade)
  against   User?            @relation("DisputeAgainst", fields: [againstId], references: [id], onDelete: SetNull)
  comments  DisputeComment[]
}

model DisputeComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  disputeId String
  userId    String
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
